options:
  parameters:
    author: gr-soarr
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Runs the full TC chain without any SDR: data_creator -> SDLS -> TC frame -> CLTU -> byte stream -> CLTU detection -> frame reassembly -> SDLS verification and decryption -> encapsulation header removal. SDLS encryption and authentication are both on, and frames go out as PLOP-1 bursts. A new frame is sent every second; each received payload is printed.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: tc_loopback_sim
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: gr-soarr TC loopback (software only)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
