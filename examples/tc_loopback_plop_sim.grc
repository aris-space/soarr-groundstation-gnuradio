options:
  parameters:
    author: gr-soarr
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Full TX -> RX chain at signal level without an SDR: plop_modulator turns CLTUs into differential BPSK, a channel model adds noise and a frequency offset, and the RX DSP chain of the USRP examples demodulates it. Switch between PLOP-1 (bursts) and PLOP-2 (continuous carrier) while it runs. SDLS encryption and authentication are on.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: tc_loopback_plop_sim
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: gr-soarr TC loopback with switchable PLOP (software only)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
