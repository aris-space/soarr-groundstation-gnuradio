# Normalize line endings in the repository; check out text files with the
# platform's native ending, except where a fixed ending is required.
* text=auto

# Run by bash on Linux/WSL, which fails on CRLF line endings.
*.sh text eol=lf
tools/git-hooks/* text eol=lf

# Windows-only scripts.
*.ps1 text eol=crlf
*.bat text eol=crlf
